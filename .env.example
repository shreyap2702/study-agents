# copy this file to .env and fill in the values
# never commit .env, it has your keys

# llm: free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
MODEL=gemini-3.5-flash-lite
# web search: free key from https://app.tavily.com
TAVILY_API_KEY=

# gmail: turn on 2-step verification, then make an app password
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# true = don't actually send, just show what would go out
DRY_RUN=false